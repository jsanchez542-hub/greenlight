{
  "name": "greenlight",
  "version": "0.1.0",
  "description": "Detects n8n workflow failures that report success",
  "license": "MIT",
  "author": "Miguel Sanchez Torres",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsanchez542-hub/greenlight.git"
  },
  "bugs": {
    "url": "https://github.com/jsanchez542-hub/greenlight/issues"
  },
  "homepage": "https://github.com/jsanchez542-hub/greenlight#readme",
  "keywords": [
    "n8n",
    "observability",
    "monitoring",
    "workflow",
    "automation",
    "silent-failures"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "greenlight": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "example": "npm run build && node examples/synthetic-instance.mjs",
    "setup": "node dist/cli.js init",
    "doctor": "node dist/cli.js doctor",
    "scan": "node dist/cli.js",
    "watch": "node dist/cli.js watch",
    "panel": "npm install --prefix web && npm run dev --prefix web",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
