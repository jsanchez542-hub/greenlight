{
  "name": "greenlight",
  "version": "0.1.0",
  "description": "Detects n8n workflow failures that report success",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "greenlight": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "example": "npm run build && node examples/synthetic-instance.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
