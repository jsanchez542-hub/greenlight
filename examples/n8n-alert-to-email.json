{
  "name": "GreenLight alerts to email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "greenlight-alert",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "5f1c7a52-3a6e-4e0b-9a51-0a1c2f6d7e01",
      "name": "GreenLight alert",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "webhookId": "9d3a8e14-6b2f-4c57-8e90-1a2b3c4d5e02"
    },
    {
      "parameters": {
        "resource": "email",
        "operation": "send",
        "fromEmail": "greenlight@example.com",
        "toEmail": "you@example.com",
        "subject": "={{ $json.body.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.body.text }}\n\nInstance: {{ $json.body.instance }}\nScanned: {{ $json.body.scannedAt }}",
        "options": {}
      },
      "id": "a7e2c9d0-4b18-4f63-b5a7-2c3d4e5f6a03",
      "name": "Send email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [260, 0]
    }
  ],
  "connections": {
    "GreenLight alert": {
      "main": [[{ "node": "Send email", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
