N8N_BASE_URL=https://your-n8n-instance.example.com
N8N_API_KEY=

# Only for `greenlight watch`
# GREENLIGHT_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/greenlight-alert
# GREENLIGHT_WEBHOOK_TOKEN=
# GREENLIGHT_INTERVAL_MINUTES=5
# GREENLIGHT_NOTIFY_MIN=warning

# Only if you must reach a public host over plain http (the key then travels unencrypted)
# GREENLIGHT_ALLOW_INSECURE_HTTP=1

# Language of the command line and the alerts: en or es (default: the language of the computer)
# GREENLIGHT_LANG=es

# Tell me when a new version is out: one request a day to GitHub, nothing about you is sent (default: off)
# GREENLIGHT_CHECK_UPDATES=1
