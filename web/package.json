{
  "name": "greenlight-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dashboard for GreenLight scan results",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "backend": "npm --prefix .. run build",
    "predev": "npm run backend",
    "dev": "next dev",
    "prebuild": "npm run backend",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "pretypecheck": "npm run backend",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "greenlight": "file:..",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
